{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://isoforge.dev/schemas/isodsl/v1/isodsl.schema.json",
  "title": "IsoDSL Scene",
  "description": "A strict, typed scene graph describing isometric cube-art on a unit grid. This document is the single source of truth for an IsoForge design: it is produced only by validated LLM tool calls, stored immutably as versions, and rendered deterministically to SVG/PNG.",
  "type": "object",
  "additionalProperties": false,
  "required": ["isodsl_version", "canvas", "grid", "palette", "shapes"],
  "properties": {
    "isodsl_version": {
      "type": "string",
      "const": "1.0.0",
      "description": "Schema version this document conforms to."
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "maxLength": 120 },
        "description": { "type": "string", "maxLength": 600 },
        "tags": {
          "type": "array",
          "maxItems": 12,
          "items": { "type": "string", "maxLength": 32 }
        }
      }
    },
    "canvas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "integer", "minimum": 16, "maximum": 4096 },
        "height": { "type": "integer", "minimum": 16, "maximum": 4096 },
        "background": {
          "oneOf": [{ "$ref": "#/$defs/color" }, { "type": "null" }],
          "default": null,
          "description": "Null means transparent."
        },
        "padding": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.45,
          "default": 0.08,
          "description": "Fraction of the smaller canvas dimension reserved as empty margin around the auto-fitted scene bounds."
        }
      }
    },
    "grid": {
      "type": "object",
      "additionalProperties": false,
      "required": ["w", "d", "h"],
      "description": "Bounds of the addressable unit-cell volume. All shape origins must fall inside it.",
      "properties": {
        "w": { "type": "integer", "minimum": 1, "maximum": 64, "description": "Extent along +x." },
        "d": { "type": "integer", "minimum": 1, "maximum": 64, "description": "Extent along +y." },
        "h": { "type": "integer", "minimum": 1, "maximum": 64, "description": "Extent along +z (up)." },
        "cell": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 512,
          "default": 32,
          "description": "Edge length of one unit cell in scene units before auto-fit scaling."
        },
        "show": {
          "type": "boolean",
          "default": false,
          "description": "Render a faint ground grid. Debug aid, off by default."
        }
      }
    },
    "camera": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "projection": {
          "type": "string",
          "enum": ["isometric", "dimetric"],
          "default": "isometric",
          "description": "isometric = true 30deg; dimetric = 2:1 pixel-art style."
        },
        "fit": {
          "type": "boolean",
          "default": true,
          "description": "Auto-scale and center the scene to the canvas. Guarantees stable framing as shapes are added."
        }
      }
    },
    "palette": {
      "type": "object",
      "additionalProperties": false,
      "required": ["colors"],
      "description": "Named colors referenced by shapes as '@palette.<name>'. Locking a theme freezes this object.",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$" },
        "name": { "type": "string", "maxLength": 80 },
        "locked": {
          "type": "boolean",
          "default": false,
          "description": "When true, shapes may only use '@palette.*' references, never literal colors."
        },
        "colors": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 24,
          "propertyNames": { "pattern": "^[a-z][a-zA-Z0-9_]{0,31}$" },
          "additionalProperties": { "$ref": "#/$defs/literalColor" }
        }
      }
    },
    "shading": {
      "type": "object",
      "additionalProperties": false,
      "description": "Automatic per-face lightness offsets applied when a shape does not specify explicit per-face fills. Keeps cube-art readable without the model having to compute three shades by hand.",
      "properties": {
        "enabled": { "type": "boolean", "default": true },
        "top": { "type": "number", "minimum": -1, "maximum": 1, "default": 0.12 },
        "left": { "type": "number", "minimum": -1, "maximum": 1, "default": -0.14 },
        "right": { "type": "number", "minimum": -1, "maximum": 1, "default": -0.28 }
      }
    },
    "effects": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "outline": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean", "default": false },
            "color": { "$ref": "#/$defs/color" },
            "width": { "type": "number", "minimum": 0, "maximum": 16, "default": 1 },
            "scope": {
              "type": "string",
              "enum": ["face", "silhouette"],
              "default": "face",
              "description": "face = stroke every face edge; silhouette = stroke only the outer hull."
            }
          }
        },
        "shadow": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean", "default": false },
            "color": { "$ref": "#/$defs/color" },
            "opacity": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.25 },
            "blur": { "type": "number", "minimum": 0, "maximum": 64, "default": 4 },
            "offset": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "x": { "type": "number", "minimum": -64, "maximum": 64, "default": 0 },
                "y": { "type": "number", "minimum": -64, "maximum": 64, "default": 4 }
              }
            }
          }
        },
        "glow": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean", "default": false },
            "color": { "$ref": "#/$defs/color" },
            "radius": { "type": "number", "minimum": 0, "maximum": 64, "default": 8 },
            "intensity": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.6 }
          }
        }
      }
    },
    "shapes": {
      "type": "array",
      "minItems": 0,
      "maxItems": 512,
      "description": "Unordered set of primitives. Paint order is derived deterministically from geometry, never from array order, so patches cannot change stacking as a side effect.",
      "items": { "$ref": "#/$defs/shape" }
    }
  },
  "$defs": {
    "literalColor": {
      "type": "string",
      "pattern": "^#(?:[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
      "description": "#RRGGBB or #RRGGBBAA. Shorthand and named CSS colors are deliberately rejected."
    },
    "paletteRef": {
      "type": "string",
      "pattern": "^@palette\\.[a-z][a-zA-Z0-9_]{0,31}$",
      "description": "Reference to a key in palette.colors."
    },
    "color": {
      "oneOf": [
        { "$ref": "#/$defs/literalColor" },
        { "$ref": "#/$defs/paletteRef" }
      ]
    },
    "gridCoord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "z"],
      "description": "Integer unit-cell coordinate. x goes right-down on screen, y goes left-down, z goes up.",
      "properties": {
        "x": { "type": "integer", "minimum": -64, "maximum": 64 },
        "y": { "type": "integer", "minimum": -64, "maximum": 64 },
        "z": { "type": "integer", "minimum": -64, "maximum": 64 }
      }
    },
    "size": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "x": { "$ref": "#/$defs/sizeComponent" },
        "y": { "$ref": "#/$defs/sizeComponent" },
        "z": { "$ref": "#/$defs/sizeComponent" }
      }
    },
    "sizeComponent": {
      "type": "number",
      "minimum": 0.25,
      "maximum": 64,
      "multipleOf": 0.25,
      "default": 1,
      "description": "Quantised to quarter cells so geometry stays exactly representable in binary floating point."
    },
    "face": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fill": { "$ref": "#/$defs/color" },
        "opacity": { "type": "number", "minimum": 0, "maximum": 1, "default": 1 },
        "stroke": { "$ref": "#/$defs/color" },
        "strokeWidth": { "type": "number", "minimum": 0, "maximum": 16, "default": 0 }
      }
    },
    "faces": {
      "type": "object",
      "additionalProperties": false,
      "description": "Per-face overrides. Any face left out inherits shape.fill with the automatic shading offset applied.",
      "properties": {
        "top": { "$ref": "#/$defs/face" },
        "left": { "$ref": "#/$defs/face" },
        "right": { "$ref": "#/$defs/face" }
      }
    },
    "shapeBase": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,47}$",
          "description": "Stable, unique, human-meaningful handle. Patches address shapes by id, so ids must not be recycled."
        },
        "at": { "$ref": "#/$defs/gridCoord" },
        "fill": { "$ref": "#/$defs/color" },
        "opacity": { "type": "number", "minimum": 0, "maximum": 1, "default": 1 },
        "visible": { "type": "boolean", "default": true },
        "label": { "type": "string", "maxLength": 80 }
      }
    },
    "shape": {
      "type": "object",
      "required": ["id", "type", "at"],
      "discriminator": { "propertyName": "type" },
      "oneOf": [
        { "$ref": "#/$defs/cube" },
        { "$ref": "#/$defs/ramp" },
        { "$ref": "#/$defs/cylinder" },
        { "$ref": "#/$defs/plane" },
        { "$ref": "#/$defs/group" }
      ]
    },
    "cube": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "at"],
      "description": "Axis-aligned box. The workhorse primitive; a thin slab is simply a cube with a small size.z.",
      "properties": {
        "id": { "$ref": "#/$defs/shapeBase/properties/id" },
        "type": { "const": "cube" },
        "at": { "$ref": "#/$defs/gridCoord" },
        "size": { "$ref": "#/$defs/size" },
        "fill": { "$ref": "#/$defs/color" },
        "faces": { "$ref": "#/$defs/faces" },
        "opacity": { "$ref": "#/$defs/shapeBase/properties/opacity" },
        "visible": { "$ref": "#/$defs/shapeBase/properties/visible" },
        "label": { "$ref": "#/$defs/shapeBase/properties/label" },
        "bevel": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.4,
          "default": 0,
          "description": "Fraction of a cell chamfered off the vertical edges."
        }
      }
    },
    "ramp": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "at", "facing"],
      "description": "Wedge sloping down toward 'facing'. Used for roofs, arrows and chamfered silhouettes.",
      "properties": {
        "id": { "$ref": "#/$defs/shapeBase/properties/id" },
        "type": { "const": "ramp" },
        "at": { "$ref": "#/$defs/gridCoord" },
        "size": { "$ref": "#/$defs/size" },
        "facing": {
          "type": "string",
          "enum": ["north", "east", "south", "west"],
          "description": "north = -y, east = +x, south = +y, west = -x."
        },
        "fill": { "$ref": "#/$defs/color" },
        "faces": { "$ref": "#/$defs/faces" },
        "opacity": { "$ref": "#/$defs/shapeBase/properties/opacity" },
        "visible": { "$ref": "#/$defs/shapeBase/properties/visible" },
        "label": { "$ref": "#/$defs/shapeBase/properties/label" }
      }
    },
    "cylinder": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "at"],
      "description": "Vertical cylinder inscribed in its bounding cells. Renders as an ellipse cap plus a side wall.",
      "properties": {
        "id": { "$ref": "#/$defs/shapeBase/properties/id" },
        "type": { "const": "cylinder" },
        "at": { "$ref": "#/$defs/gridCoord" },
        "size": { "$ref": "#/$defs/size" },
        "segments": {
          "type": "integer",
          "minimum": 6,
          "maximum": 128,
          "default": 48,
          "description": "Tessellation count. Fixed integer so output stays byte-identical across renders."
        },
        "fill": { "$ref": "#/$defs/color" },
        "faces": { "$ref": "#/$defs/faces" },
        "opacity": { "$ref": "#/$defs/shapeBase/properties/opacity" },
        "visible": { "$ref": "#/$defs/shapeBase/properties/visible" },
        "label": { "$ref": "#/$defs/shapeBase/properties/label" }
      }
    },
    "plane": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "at", "orientation"],
      "description": "Zero-thickness quad on one of the three isometric planes. Useful for floors, backdrops and inlay detail.",
      "properties": {
        "id": { "$ref": "#/$defs/shapeBase/properties/id" },
        "type": { "const": "plane" },
        "at": { "$ref": "#/$defs/gridCoord" },
        "size": { "$ref": "#/$defs/size" },
        "orientation": {
          "type": "string",
          "enum": ["top", "left", "right"],
          "description": "Which isometric face plane the quad lies in."
        },
        "fill": { "$ref": "#/$defs/color" },
        "opacity": { "$ref": "#/$defs/shapeBase/properties/opacity" },
        "visible": { "$ref": "#/$defs/shapeBase/properties/visible" },
        "label": { "$ref": "#/$defs/shapeBase/properties/label" },
        "stroke": { "$ref": "#/$defs/color" },
        "strokeWidth": { "type": "number", "minimum": 0, "maximum": 16, "default": 0 }
      }
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "at", "children"],
      "description": "Translates its children by 'at'. Children are flattened before depth sorting, so a group never overrides global paint order.",
      "properties": {
        "id": { "$ref": "#/$defs/shapeBase/properties/id" },
        "type": { "const": "group" },
        "at": { "$ref": "#/$defs/gridCoord" },
        "children": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": { "$ref": "#/$defs/shape" }
        },
        "opacity": { "$ref": "#/$defs/shapeBase/properties/opacity" },
        "visible": { "$ref": "#/$defs/shapeBase/properties/visible" },
        "label": { "$ref": "#/$defs/shapeBase/properties/label" }
      }
    }
  }
}
